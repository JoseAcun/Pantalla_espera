# Twitch application credentials. Never commit the real .env file.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# User token for the broadcaster account. Required for the EventSub phase.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_BROADCASTER_ID=
# Must exactly match an OAuth Redirect URL configured in the Twitch Developer Console.
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback
# Local default; Docker Compose persists the token at /data/twitch_tokens.json instead.
TWITCH_TOKEN_FILE=.twitch_tokens.json

# Optional MariaDB persistence. In Docker, use the shared Docker-network hostname.
# DATABASE_URL=mysql+pymysql://twitch_overlay:CHANGE_ME@mariadb:3306/twitch_overlay
DATABASE_URL=
# Curva de nivel STREAM_OS: cada salto crece 15%, redondeado a múltiplos de 5.
GAME_LEVEL_BASE_XP=100
GAME_LEVEL_GROWTH=1.15
GAME_LEVEL_ROUNDING=5
# Required only to use POST /api/twitch/manual/subscriber; choose a long random value.
OVERLAY_ADMIN_TOKEN=
# Local folder for the Pokémon team and cached sprites. Docker uses /data automatically.
POKEMON_DATA_DIR=data

# Host port used only by Docker Compose. Keep 8010 if another service uses 8000.
OVERLAY_PORT=8010

# Optional manual overlay values.
OVERLAY_STATUS=AFK
OVERLAY_EPISODE=
OVERLAY_CUSTOM_MESSAGE=

# Analytics: at most one viewer sample per active stream session and interval.
VIEWER_SNAPSHOT_INTERVAL_SECONDS=300
