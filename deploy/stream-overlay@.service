[Unit]
Description=Twitch Stream Overlay (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/stream-overlay
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/%i/stream-overlay/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
